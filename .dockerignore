# Keeps the Docker build context small and keeps local runtime state, keys and
# test output out of what is sent to the Docker daemon. Only runtime-only and
# generated material is listed: everything the images COPY or may need to
# COPY (src/, scripts/, docker/, templates/, static/, models/, requirements*.txt)
# is deliberately NOT ignored.
.git
**/__pycache__
**/*.pyc
.pytest_cache
.coverage
htmlcov
logs
data
storage
receipts
keys
cookies.txt
replay_pid1000.log
benchmark_report.json
run1.json
*.db
*.db.bak
.env
.env.*
